# Ignore build directories
**/build/

# Ignore Visual Studio specific files
.vs/
.vscode/
.vsconfig
*.user
*.userosscache
*.suo
*.sdf
*.sln
*.sln.docstates

# Ignore Visual Studio vcx files
*.vcxproj
*.vcxproj.*

# Ignore generated files from builds
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.idb
*.exe
*.app

# Ignore core dumps
core.*

# Ignore temporary files from the OS
.DS_Store
Thumbs.db

# Ignore other IDE-specific files
.idea/

# Ignore macOS specific files
.DS_Store

# Stray/unused vendor header dump (not referenced by CMakeLists; build uses src/Runtime/vendor/glm)
/src/Runtime/include/glm/



# CMake files
CMakeCache.txt
CMakeFiles/
CMakeSettings.json
Makefile
cmake_install.cmake
*.cmake

# Ignore CMake generated folders/files in subdirectories
**/CMakeFiles/**
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
/Testing/Temporary/LastTest.log


# Temp ignore folders
scripts/x64
scripts/x64/*
scripts/GLAD.dir
scripts/GameEngine.dir
scripts/NeonRuntime.dir
scripts/NeonVoid.dir

# these files should only exist here after install
# so we keep them ignored for project
src/Runtime/include/**
!src/Runtime/include/NeonRuntime

